{# ======================= #}
{# PROPERTIES              #}
{# ======================= #}
{% set siteName = craft.app.sites.currentSite.name %}
{% set emailLanguage = (craft.app.sites.currentSite.language ?? 'en-US')|slice(0, 2) %}

{% set fontFamily = "-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif" %}

{% set containerStyle = "max-width: 600px; margin: 0 auto; background-color: #ffffff; border: 1px solid #e5e7eb; border-radius: 8px; overflow: hidden;" %}
{% set accentBarStyle = "height: 4px; line-height: 4px; font-size: 0; background-color: #111827;" %}
{% set contentStyle = "padding: 36px 32px; font-family: " ~ fontFamily ~ "; font-size: 15px; color: #374151;" %}
{% set siteNameStyle = "margin: 0 0 20px 0; font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #6b7280;" %}
{% set headingStyle = "margin: 0 0 16px 0; font-size: 21px; line-height: 1.3; font-weight: 700; color: #111827;" %}
{% set textStyle = "margin: 0 0 16px 0; line-height: 1.6; color: #374151;" %}
{% set dividerStyle = "border: none; border-top: 1px solid #e5e7eb; margin: 28px 0;" %}
{% set buttonStyle = "display: inline-block; background-color: #111827; color: #ffffff; text-decoration: none; font-size: 14px; font-weight: 600; padding: 12px 28px; border-radius: 6px;" %}
{% set footerStyle = "margin: 24px auto 0; max-width: 600px; padding: 0 32px; text-align: center; font-family: " ~ fontFamily ~ "; font-size: 12px; line-height: 1.6; color: #6b7280;" %}

{% set panelStyle = "width: 100%; border-collapse: collapse; background-color: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px; margin: 20px 0;" %}
{% set panelLabelCellStyle = "padding: 12px 16px; font-size: 13px; color: #6b7280;" %}
{% set panelValueCellStyle = "padding: 12px 16px; font-size: 14px; font-weight: 600; color: #111827; text-align: right;" %}
{% set panelRowBorderStyle = "border-top: 1px solid #e5e7eb;" %}

{% set tableHeaderStyle = "padding: 10px 12px; text-align: left; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; color: #6b7280; background-color: #f9fafb; border-bottom: 1px solid #e5e7eb;" %}
{% set tableCellStyle = "padding: 12px; border-bottom: 1px solid #e5e7eb; color: #374151;" %}

{# ======================= #}
{# TEMPLATE                #}
{# ======================= #}
<!DOCTYPE html>
<html lang="{{ emailLanguage }}">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <title>{{ siteName }}</title>
</head>

<body style="margin: 0; padding: 24px 16px; background-color: #f3f4f6;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="{{ containerStyle }}">
        <tr>
            <td style="{{ accentBarStyle }}">&nbsp;</td>
        </tr>
        <tr>
            <td style="{{ contentStyle }}">
                <div style="{{ siteNameStyle }}">{{ siteName }}</div>
                {% block content %}{% endblock %}
            </td>
        </tr>
    </table>

    <p style="{{ footerStyle }}">{{ 'This is an automated message from {site}.'|t('qr-payments', { site: siteName }) }}</p>
</body>

</html>
