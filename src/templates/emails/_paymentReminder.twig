{% extends "qr-payments/emails/_layout" %}

{# @var payment \digitalastronaut\craftqrpayments\elements\Payment #}

{% set status = payment.getStatus() %}

{# ======================= #}
{# TEMPLATE                #}
{# ======================= #}
{% block content %}
    {% if status == 'expired' %}
        <h2 style="{{ heading2Style }}">{{ "Your payment is overdue"|t('qr-payments') }}</h2>
        <p style="{{ textStyle }}">{{ "The due date for the following payment has passed. Please settle it as soon as possible:"|t('qr-payments') }}</p>
    {% else %}
        <h2 style="{{ heading2Style }}">{{ "Your payment is due soon"|t('qr-payments') }}</h2>
        <p style="{{ textStyle }}">{{ "This is a friendly reminder that the following payment is due in 7 days:"|t('qr-payments') }}</p>
    {% endif %}

    <ul>
        <li style="{{ textStyle }}"><span style="{{ labelStyle }}">{{ "Beneficiary:"|t('qr-payments') }}</span>{{ payment.beneficiaryName }}</li>
        <li style="{{ textStyle }}"><span style="{{ labelStyle }}">{{ "IBAN:"|t('qr-payments') }}</span>{{ payment.iban }}</li>
        {% if payment.bic %}<li style="{{ textStyle }}"><span style="{{ labelStyle }}">{{ "BIC:"|t('qr-payments') }}</span>{{ payment.bic }}</li>{% endif %}
        <li style="{{ textStyle }}"><span style="{{ labelStyle }}">{{ "Amount:"|t('qr-payments') }}</span>{{ payment.amount|money }}</li>
        <li style="{{ textStyle }}"><span style="{{ labelStyle }}">{{ "Reference:"|t('qr-payments') }}</span>{{ payment.remittanceReference }}</li>
        <li style="{{ textStyle }}"><span style="{{ labelStyle }}">{{ "Due date:"|t('qr-payments') }}</span>{{ payment.dueDate|date('Y-m-d') }}</li>
    </ul>

    <p style="{{ textStyle }}"><a href="{{ payment.getUrl() }}">{{ "View payment"|t('qr-payments') }}</a></p>
{% endblock %}
