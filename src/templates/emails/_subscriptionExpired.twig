{# ======================= #}
{# PROPERTIES              #}
{# ======================= #}
{% extends "qr-payments/emails/_layout" %}

{# @var subscription \digitalastronaut\craftqrpayments\elements\Subscription #}
{# @var paymentUrl string|null The latest payment's pay page — see `SendSubscriptionExpiredEmailJob::getTemplateVariables()`. #}

{# ======================= #}
{# TEMPLATE                #}
{# ======================= #}
{% block content %}
    <h1 style="{{ headingStyle }}">{{ 'Subscription expired'|t('qr-payments') }}</h1>

    <p style="{{ textStyle }}{{ paymentUrl ? '' : ' margin-bottom: 0;' }}">
        {{ 'Your subscription to'|t('qr-payments') }} <strong>{{ subscription.subscriptionType.name }}</strong> {{ 'has expired. Pay the latest request to reactivate it.'|t('qr-payments') }}
    </p>

    {% if paymentUrl %}
        <p style="margin: 24px 0 0 0; text-align: center;">
            <a href="{{ paymentUrl }}" style="{{ buttonStyle }}">{{ 'Pay now'|t('qr-payments') }}</a>
        </p>
    {% endif %}
{% endblock %}
