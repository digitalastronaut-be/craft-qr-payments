{% extends "qr-payments/emails/_layout" %}

{# @var payment \digitalastronaut\craftqrpayments\elements\Payment #}

{% set detailRows = [
    { label: 'Beneficiary'|t('qr-payments'), value: payment.beneficiaryName },
    { label: 'IBAN'|t('qr-payments'), value: payment.iban },
    { label: 'BIC'|t('qr-payments'), value: payment.bic },
    { label: 'Amount'|t('qr-payments'), value: payment.amount|money },
    { label: 'Reference'|t('qr-payments'), value: payment.remittanceReference },
    { label: 'Due date'|t('qr-payments'), value: payment.dueDate ? payment.dueDate|date('d F Y') : null },
]|filter(row => row.value) %}

{# ======================= #}
{# TEMPLATE                #}
{# ======================= #}
{% block content %}
    <h1 style="{{ headingStyle }}">{{ 'Payment request'|t('qr-payments') }}</h1>

    <p style="{{ textStyle }}">
        {{ 'A payment of {amount} has been requested from you.'|t('qr-payments', { amount: payment.amount|money }) }}
        {{ 'Scan the QR code below with your banking app to pay instantly.'|t('qr-payments') }}
    </p>

    <p style="margin: 0 0 20px 0; text-align: center;">
        <img src="{{ qrContentId }}" width="180" height="180" alt="{{ 'Payment QR code'|t('qr-payments') }}" style="display: inline-block; width: 180px; height: 180px;">
    </p>

    <hr style="{{ dividerStyle }}">

    <p style="{{ textStyle }}">{{ 'Or transfer manually using these details:'|t('qr-payments') }}</p>

    <table style="{{ panelStyle }}" cellpadding="0" cellspacing="0" role="presentation">
        {% for row in detailRows %}
            <tr>
                <td style="{{ panelLabelCellStyle }}{{ not loop.first ? panelRowBorderStyle : '' }}">{{ row.label }}</td>
                <td style="{{ panelValueCellStyle }}{{ not loop.first ? panelRowBorderStyle : '' }}">{{ row.value }}</td>
            </tr>
        {% endfor %}
    </table>

    <p style="{{ textStyle }} margin-bottom: 0;">{{ 'Make sure to use the reference above so your payment can be matched automatically.'|t('qr-payments') }}</p>

    <p style="margin: 24px 0 0 0; text-align: center;">
        <a href="{{ payment.getUrl() }}" style="{{ buttonStyle }}">{{ 'View payment'|t('qr-payments') }}</a>
    </p>
{% endblock %}
