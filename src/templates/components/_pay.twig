{# @var payment \digitalastronaut\craftqrpayments\elements\Payment #}
{# @var qrCodeDataUri string|null #}

{% set status = payment.getStatus() %}
{% set actionable = status in ['requested', 'partial'] %}

{% set statusCopy = {
    'requested': {
        badge: 'Payment requested'|t('qr-payments'),
        heading: 'Scan to pay'|t('qr-payments'),
        body: 'Scan the QR code below with your banking app to pay instantly.'|t('qr-payments'),
    },
    'partial': {
        badge: 'Partially paid'|t('qr-payments'),
        heading: 'Scan to pay the rest'|t('qr-payments'),
        body: 'You’ve paid {paid} of {total} so far. Scan the QR code below to pay the remaining {remaining}.'|t('qr-payments', {
            paid: payment.netPaidAmount|money,
            total: payment.amount|money,
            remaining: payment.remainingAmount|money,
        }),
    },
    'reported': {
        badge: 'Marked paid'|t('qr-payments'),
        heading: 'Thanks we’ve been notified'|t('qr-payments'),
        body: 'We’ve let the beneficiary know you’ve paid. This page will update automatically once it’s confirmed, so there’s nothing else for you to do.'|t('qr-payments'),
    },
    'paid': {
        badge: 'Paid'|t('qr-payments'),
        heading: 'Payment received'|t('qr-payments'),
        body: 'Thank you — this payment has been received in full. There’s nothing left to pay.'|t('qr-payments'),
    },
    'overpaid': {
        badge: 'Overpaid'|t('qr-payments'),
        heading: 'Payment received'|t('qr-payments'),
        body: 'You’ve paid {paid}, which is {overpaid} more than the {total} requested. The beneficiary will refund the difference.'|t('qr-payments', {
            paid: payment.netPaidAmount|money,
            total: payment.amount|money,
            overpaid: payment.overpaidAmount|money,
        }),
    },
    'expired': {
        badge: 'Expired'|t('qr-payments'),
        heading: 'Payment request expired'|t('qr-payments'),
        body: 'This payment request expired {duration} ago and can no longer be paid through this page. Contact the beneficiary if you still need to pay.'|t('qr-payments', {
            duration: payment.dueInLabel,
        }),
    },
    'cancelled': {
        badge: 'Cancelled'|t('qr-payments'),
        heading: 'Payment cancelled'|t('qr-payments'),
        body: 'This payment request was cancelled. No payment is needed.'|t('qr-payments'),
    },
    'refunded': {
        badge: 'Refunded'|t('qr-payments'),
        heading: 'Payment refunded'|t('qr-payments'),
        body: 'The {amount} you paid was refunded in full.'|t('qr-payments', {
            amount: payment.refundedAmount|money,
        }),
    },
}[status] %}

{% if actionable %}

    {% set detailRows = [
        { label: 'Beneficiary:'|t('qr-payments'), value: payment.beneficiaryName },
        { label: 'IBAN:'|t('qr-payments'), value: payment.iban },
        payment.bic ? { label: 'BIC:'|t('qr-payments'), value: payment.bic } : null,
        { label: 'Total price:'|t('qr-payments'), value: payment.amount|money },
        status == 'partial' ? { label: 'Paid so far:'|t('qr-payments'), value: payment.netPaidAmount|money } : null,
        status == 'partial' ? { label: 'Remaining:'|t('qr-payments'), value: payment.remainingAmount|money } : null,
        { label: 'Reference:'|t('qr-payments'), value: payment.remittanceReference },
        payment.dueDate ? { label: 'Time left to pay:'|t('qr-payments'), value: payment.dueInLabel } : null,
    ]|filter(row => row is not null) %}

{% elseif status == 'overpaid' %}

    {% set detailRows = [
        { label: 'Total price:'|t('qr-payments'), value: payment.amount|money },
        { label: 'Paid:'|t('qr-payments'), value: payment.grossPaidAmount|money },
        payment.refundedAmount.isPositive() ? { label: 'Refunded so far:'|t('qr-payments'), value: payment.refundedAmount|money } : null,
        { label: 'Still to be refunded:'|t('qr-payments'), value: payment.overpaidAmount|money },
        { label: 'Reference:'|t('qr-payments'), value: payment.remittanceReference },
    ]|filter(row => row is not null) %}

{% elseif status == 'refunded' %}

    {% set detailRows = [
        { label: 'Paid:'|t('qr-payments'), value: payment.grossPaidAmount|money },
        { label: 'Refunded:'|t('qr-payments'), value: payment.refundedAmount|money },
        { label: 'Reference:'|t('qr-payments'), value: payment.remittanceReference },
    ] %}

{% else %}

    {% set detailRows = [
        { label: 'Amount:'|t('qr-payments'), value: payment.amount|money },
        { label: 'Reference:'|t('qr-payments'), value: payment.remittanceReference },
    ] %}

{% endif %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ 'Pay your order'|t('qr-payments') }}</title>
</head>
<body class="qr-pay">
    <span class="qr-pay__badge qr-pay__badge--{{ status }}">{{ statusCopy.badge }}</span>
    <h1>{{ statusCopy.heading }}</h1>
    <p>{{ statusCopy.body }}</p>

    {% if actionable %}
        {% if qrCodeDataUri %}
            <img class="qr-pay__qr-code" src="{{ qrCodeDataUri }}" alt="{{ 'Payment QR code'|t('qr-payments') }}">
        {% endif %}

        <p>{{ 'Or transfer manually using these details:'|t('qr-payments') }}</p>

        <ul class="qr-pay__details">
            {% for row in detailRows %}
                <li><strong>{{ row.label }}</strong> {{ row.value }}</li>
            {% endfor %}
        </ul>

        {% if payment.canReportPaidByPayer() %}
            <form class="qr-pay__report-form" method="post" action="">
                {{ actionInput('qr-payments/payments/report-paid') }}
                {{ redirectInput(payment.url) }}
                {{ csrfInput() }}
                {{ hiddenInput('uid', payment.uid) }}
                <button class="qr-pay__report-btn" type="submit">{{ 'I’ve paid'|t('qr-payments') }}</button>
            </form>
        {% endif %}
    {% else %}
        <ul class="qr-pay__details qr-pay__details--summary">
            {% for row in detailRows %}
                <li><strong>{{ row.label }}</strong> {{ row.value }}</li>
            {% endfor %}
        </ul>
    {% endif %}
</body>
</html>
