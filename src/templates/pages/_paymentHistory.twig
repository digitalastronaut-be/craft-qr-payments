{% extends "_layouts/elementindex" %}

{% set selectedSubnavItem = 'payments' %}

{% set title = "Payments"|t('qr-payments') %}
{% set elementType = 'digitalastronaut\\craftqrpayments\\elements\\Payment' %}

{% set crumbs = [
    { label: 'QR payments'|t('qr-payments'), url: url('qr-payments') },
    { label: 'Payment history'|t('qr-payments'), url: url('qr-payments/payments') },
] %}

{% set additionalButtons %}
    <a class="btn" href="{{ url('qr-payments/payments/process') }}">
        {{ "Bulk processing"|t('qr-payments') }}
    </a>
{% endset %}

{% block actionButton %}
    <button type="button" class="btn submit add icon" id="qrp-new-payment">
        {{ "New payment"|t('qr-payments') }}
    </button>
{% endblock %}

{% js %}
    document.getElementById('qrp-new-payment').addEventListener('click', () => {
        Craft.sendActionRequest('POST', 'elements/create', {
            data: { elementType: '{{ elementType|e("js") }}' },
        }).then((response) => {
            document.location.href = Craft.getUrl(response.data.cpEditUrl, { fresh: 1 });
        }).catch((error) => {
            Craft.cp.displayError(error?.response?.data?.message);
        });
    });
{% endjs %}
