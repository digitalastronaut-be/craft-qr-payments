{% extends "_layouts/cp.twig" %}

{% import '_includes/forms.twig' as forms %}

{% set fullPageForm = true %}
{% set title = "New payment"|t('qr-payments') %}
{% set selectedSubnavItem = 'payments' %}

{% set crumbs = [
    { label: 'Payments'|t('qr-payments'), url: url('qr-payments/payments') },
] %}

{% set details %}
    <dl class="meta read-only">
        <div class="data">
            <dt class="heading">{{ 'Beneficiary'|t('qr-payments') }}</dt>
            <dd class="value">{{ settings.getBeneficiaryName() }}</dd>
        </div>
        <div class="data">
            <dt class="heading">{{ 'IBAN'|t('qr-payments') }}</dt>
            <dd class="value">{{ settings.getIban() }}</dd>
        </div>
        {% if settings.getBic() %}
            <div class="data">
                <dt class="heading">{{ 'BIC'|t('qr-payments') }}</dt>
                <dd class="value">{{ settings.getBic() }}</dd>
            </div>
        {% endif %}
    </dl>
{% endset %}

{% block content %}
    {{ actionInput('qr-payments/payments/save') }}

    <div class="flex-fields">
        {{ forms.textField({
            label: 'Email'|t('qr-payments'),
            instructions: 'Where the payment QR code and status updates should be sent.'|t('qr-payments'),
            id: 'email',
            name: 'email',
            type: 'email',
            fieldClass: 'width-50',
            value: email ?? null,
            required: true,
        }) }}

        {{ forms.moneyField({
            label: 'Amount'|t('qr-payments'),
            instructions: 'The amount to request from the payer.'|t('qr-payments'),
            id: 'amount',
            name: 'amount',
            currency: 'EUR',
            currencyLabel: '(EUR) €',
            value: amount ?? null,
            required: true,
            autofocus: true,
        }) }}

        {% for tab in fieldLayout.getTabs() %}
            {% for layoutElement in tab.getElements() %}
                {{ layoutElement.formHtml(payment, false)|raw }}
            {% endfor %}
        {% endfor %}
    </div>
{% endblock %}
